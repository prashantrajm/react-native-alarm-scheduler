{
  "expo": {
    "name": "react-native-alarm-scheduler-example",
    "slug": "react-native-alarm-scheduler-example",
    "scheme": "alarm-scheduler-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "expo.modules.alarm.example"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "expo.modules.alarm.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "../app.plugin.js",
        {
          "alarmKitUsageDescription": "Allow the example app to schedule native alarms."
        }
      ]
    ]
  }
}
